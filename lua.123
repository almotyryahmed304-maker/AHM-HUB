--==================================================
-- AIM
--==================================================

local AIM_MODES = {

	{
		name = "Head",
		part = "Head"
	},

	{
		name = "Torso",
		part = "HumanoidRootPart"
	},

	{
		name = "Right Arm",
		part = "RightUpperArm"
	},

	{
		name = "Left Arm",
		part = "LeftUpperArm"
	}

}

local currentModeIndex = 1

local function IsAlive(character)

	local humanoid =
		character
		and character:FindFirstChildOfClass("Humanoid")

	return humanoid
		and humanoid.Health > 0
end

local function IsVisible(part)

	if not part then
		return false
	end

	local origin =
		Camera.CFrame.Position

	local direction =
		part.Position - origin

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		LocalPlayer.Character,
		part.Parent
	}

	local result =
		workspace:Raycast(
			origin,
			direction,
			params
		)

	return result == nil
end

local function GetTargetPart(character)

	local mode =
		AIM_MODES[currentModeIndex]

	local part =
		character:FindFirstChild(mode.part)

	if not part
		and mode.part == "RightUpperArm" then

		part =
			character:FindFirstChild("Right Arm")
	end

	if not part
		and mode.part == "LeftUpperArm" then

		part =
			character:FindFirstChild("Left Arm")
	end

	return part
		or character:FindFirstChild("Head")
		or character:FindFirstChild("HumanoidRootPart")
end

local function GetClosestTarget()

	local closest = nil
	local closestDistance = math.huge

	local center =
		Camera.ViewportSize / 2

	for _,player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LocalPlayer
			and not ProtectedPlayers[player]
			and player.Character
			and IsAlive(player.Character) then

			local part =
				GetTargetPart(player.Character)

			if part then

				local screenPos,onScreen =
					Camera:WorldToViewportPoint(
						part.Position
					)

				if onScreen then

					local distance =
						(
							Vector2.new(
								screenPos.X,
								screenPos.Y
							) - center
						).Magnitude

					if distance <
						closestDistance
						and distance <= FOVRadius then

						if
							not WallCheckEnabled
							or IsVisible(part)
						then

							closestDistance =
								distance

							closest =
								player
						end
					end
				end
			end
		end
	end

	return closest
end

