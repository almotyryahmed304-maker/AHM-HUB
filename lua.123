	UDim2.new(
		0,
		FOVRadius*2,
		0,
		FOVRadius*2
	)

FOVCircle.Parent = ScreenGui

local CircleStroke =
	Instance.new("UIStroke")

CircleStroke.Thickness = 2
CircleStroke.Color =
	Color3.fromRGB(255,0,0)

CircleStroke.Parent = FOVCircle

